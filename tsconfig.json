{
	"compilerOptions": {
		"allowJs": false,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"incremental": true,
		"ignoreDeprecations": "6.0",
		"isolatedModules": true,
		"jsx": "react-jsx",
		"lib": ["dom", "dom.iterable", "esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"baseUrl": ".",
		"paths": {
			"@components/*": ["src/components/*"],
			"@ui/*": ["src/components/ui/*"],
			"@ui": ["src/components/ui/index.ts"],
			"@widgets/*": ["src/components/Widgets/*"],
			"@icons/svg/*": ["src/components/Icons/svg/*"],
			"@icons/Audio": ["src/components/Icons/Audio.tsx"],
			"@util/*": ["src/util/*"],
			"@data/*": ["src/data/*"],
			"@views/*": ["src/views/*"],
			"@storage/*": ["src/storage/*"],
			"@diagrams/*": ["src/diagrams/*"],
			"@sync/*": ["src/sync/*"]
		}
	},
	"include": [
		"svgr.d.ts",
		"next-env.d.ts",
		".next/types/**/*.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/dev/types/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/*.spec.ts",
		"**/*.spec.tsx",
		"public/sw.js",
		"public/workbox-*.js",
		"public/fallback-*.js"
	]
}
