# Public application URL used when generating absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Logging: debug, info, warn, error, or silent.
NEXT_PUBLIC_LOG_LEVEL=debug
LOG_LEVEL=debug

# For self-hosting behind a trusted proxy, set its client-IP header name.
# The proxy must overwrite this header and prevent direct access to the app.
# Default: x-vercel-forwarded-for; example: x-forwarded-for or x-real-ip.
TRUSTED_CLIENT_IP_HEADER=

# MongoDB-backed accounts and personal data (optional for public/offline UI).
MONGO_URL=
MONGO_DB=

# AWS-compatible storage (optional unless AWS storage is enabled).
AWS_REGION=sfo3
AWS_ENDPOINT=
AWS_BUCKET=
AWS_ID=
AWS_SECRET=

# Required in production to authorize public RSS media and transcript links.
RSS_MEDIA_SECRET=

# Wasabi public/proxy base URL (optional unless Wasabi storage is enabled).
WASABI_URL=

# Password-reset email delivery (optional).
GMAIL_USER=
GMAIL_PASSWORD=
GMAIL_FROM=
