			"mode": "required"
		},
		"runtime-accessibility": {
			"mode": "required"
		},
		"visual-regression": {
			"mode": "required"
		},
		"interactions": {
			"mode": "required"
		},
		"styles": {
			"mode": "required"
		}
	}
}
